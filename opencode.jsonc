{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*--force*": "deny",
      "git push*-f *": "deny",
      "git push*-f": "deny",
      "git reset*--hard*": "deny",
      "git clean*-f*": "deny",
      "git clean*--force*": "deny",
      "git checkout -- .": "deny",
      "git checkout .": "deny",
      "git checkout -- :/": "deny",
      "git restore .": "deny",
      "git restore :/": "deny",
      "git restore --worktree .": "deny",
      "git restore --worktree :/": "deny",
      "git branch*-D*": "ask",
      "rm -rf *": "ask",
      "rm -fr *": "ask",
      "rm -r -f *": "ask"
    },
    "edit": {
      "*": "allow",
      "*flake.lock": "deny",
      "*lazy-lock.json": "ask"
    }
  }
}